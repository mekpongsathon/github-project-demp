{
  "mcpServers": {
    "github-workflow": {
      "command": "node",
      "args": ["${workspaceFolder}/mcp-server/dist/index.js"],
      "env": {
        "GITHUB_TOKEN": "${env:GITHUB_TOKEN}",
        "GITHUB_OWNER": "${env:GITHUB_OWNER}",
        "GITHUB_REPO": "${env:GITHUB_REPO}",
        "WORKFLOW_PROJECT_ID": "${env:WORKFLOW_PROJECT_ID}",
        "WORKFLOW_STATUS_FIELD_ID": "${env:WORKFLOW_STATUS_FIELD_ID}",
        "WORKFLOW_IN_PROGRESS_OPTION_ID": "${env:WORKFLOW_IN_PROGRESS_OPTION_ID}",
        "WORKFLOW_CODE_REVIEW_OPTION_ID": "${env:WORKFLOW_CODE_REVIEW_OPTION_ID}",
        "WORKFLOW_DONE_OPTION_ID": "${env:WORKFLOW_DONE_OPTION_ID}",
        "WORKFLOW_DEPLOY_DEV_FIELD_ID": "${env:WORKFLOW_DEPLOY_DEV_FIELD_ID}",
        "WORKFLOW_DEPLOY_UAT_FIELD_ID": "${env:WORKFLOW_DEPLOY_UAT_FIELD_ID}",
        "WORKFLOW_DEPLOY_PROD_FIELD_ID": "${env:WORKFLOW_DEPLOY_PROD_FIELD_ID}",
        "WORKFLOW_DEPLOY_WAITING_OPTION_ID": "${env:WORKFLOW_DEPLOY_WAITING_OPTION_ID}",
        "WORKFLOW_DEPLOY_DEPLOYING_OPTION_ID": "${env:WORKFLOW_DEPLOY_DEPLOYING_OPTION_ID}",
        "WORKFLOW_DEPLOY_DEPLOYED_OPTION_ID": "${env:WORKFLOW_DEPLOY_DEPLOYED_OPTION_ID}",
        "WORKFLOW_DEPLOY_FAILED_OPTION_ID": "${env:WORKFLOW_DEPLOY_FAILED_OPTION_ID}"
      }
    }
  }
}
